# Copy this file to .env and fill real values.

NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Optional backend secret for production features that need service-role access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional retraining export jobs. Keep disabled unless you intentionally retain CSV snapshots.
FEEDBACK_AGGREGATOR_ENABLED=0
UPLOAD_ARCHIVE_ENABLED=0

# Optional developer convenience. Keep disabled in production.
ENABLE_API_DOCS=0
