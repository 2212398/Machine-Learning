# Environment example for local / VPS deployment
# Copy this file to `.env` and replace placeholders with real values from Supabase
# Do NOT commit your real `.env` to the repository.

# Supabase (public client values)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key

# Backend API used by the frontend at runtime (use internal docker hostname when running via docker-compose)
NEXT_PUBLIC_FASTAPI_URL=http://backend:8000

# Backend-only secret key (Service Role) — set only in backend service env, keep secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: override Next.js public env to a production URL when building for production
# NEXT_PUBLIC_APP_URL=https://your-domain.example

# Notes:
# - To get Supabase project URL and anon key: in Supabase console -> Project Settings -> API
# - To get Service Role key: Supabase console -> Project Settings -> API -> Service key (keep secret)
# - Create `.env` from this file on the server and fill in values, then run `docker-compose up --build -d`
